
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void matrix_multiply(int a[4][4], int b[4], int c[4]) {
    for (int i = 0; i < 4; i++) {
        c[i] = 0;

        for (int j = 0; j < 4; j++) {
            c[i] += a[i][j] * b[j];
        }
    }
}

int main() {
    int a[4][4];
    int b[4];
    int c[4];

    srand(time(NULL));

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            a[i][j] = rand() % 10;
        }
    }

    for (int i = 0; i < 4; i++) {
        b[i] = rand() % 10;
    }

    matrix_multiply(a, b, c);

    printf("Matriks A (4x4):\n");

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }

    printf("\nMatriks B (4x1):\n");

    for (int i = 0; i < 4; i++) {
        printf("%d\n", b[i]);
    }

    printf("\nHasil Perkalian Matriks (4x1):\n");

    for (int i = 0; i < 4; i++) {
        printf("%d\n", c[i]);
    }

    return 0;
}
